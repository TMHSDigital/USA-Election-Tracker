---
// Index of every race for one office. House races are grouped by state with
// a sticky jump bar; Senate and governor races are one grid of tiles.
import Base from '../layouts/Base.astro';
import PageHeader from './PageHeader.astro';
import { ADAPTERS_FOR, getRaceIndex, type Office, type RaceSummary } from '../lib/data';
import { officeName, raceTitle, raceUrl, stateUrl } from '../lib/format';
import { t } from '../i18n';

interface Props {
  office: Office;
}
const { office } = Astro.props;
const races = getRaceIndex()
  .filter((r) => r.office === office)
  .sort((a, b) => a.state_name.localeCompare(b.state_name) || (a.district ?? 0) - (b.district ?? 0) || Number(a.special) - Number(b.special));
const introKey = { house: 'office.index.house', senate: 'office.index.senate', governor: 'office.index.governors' }[office] as 'office.index.house';
const byState = new Map<string, RaceSummary[]>();
for (const r of races) byState.set(r.state_name, [...(byState.get(r.state_name) ?? []), r]);
const statusText = (r: RaceSummary) =>
  r.list_status === 'official'
    ? (r.candidate_count === 1 ? t('state.candidateCountOne') : t('state.candidateCount', { count: r.candidate_count }))
    : t(`state.listStatus.${r.list_status}` as 'state.listStatus.unavailable');
---
<Base title={officeName(office)} description={t(introKey, { count: races.length })} adapters={ADAPTERS_FOR.state}>
  <PageHeader title={officeName(office)} lede={t(introKey, { count: races.length })} />
  {office === 'house' ? (
    <>
      <nav class="jump" aria-label={t('office.jump')}>
        <ul>
          {[...byState.values()].map((list) => (
            <li><a href={`#s-${list[0].state_po}`} title={list[0].state_name}>{list[0].state_po}</a></li>
          ))}
        </ul>
      </nav>
      {[...byState.entries()].map(([state, list]) => (
        <section aria-labelledby={`s-${list[0].state_po}`} class="index-state">
          <h2 id={`s-${list[0].state_po}`}><a href={stateUrl(list[0].state_po)}>{state}</a></h2>
          <ul class="tiles">
            {list.map((r) => <li><a href={raceUrl(r.race_id)}>{raceTitle(r)}</a><span class="note">{statusText(r)}</span></li>)}
          </ul>
        </section>
      ))}
    </>
  ) : (
    <ul class="tiles wide">
      {races.map((r) => <li><a href={raceUrl(r.race_id)}>{raceTitle(r)}</a><span class="note">{statusText(r)}</span></li>)}
    </ul>
  )}
</Base>

<style is:global>
  .index-state { scroll-margin-top: 4rem; }
  .index-state h2 { margin-top: var(--s4); }
  .index-state h2 a { text-decoration: none; }
  .index-state h2 a:hover { text-decoration: underline; }
</style>
