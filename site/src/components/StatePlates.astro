---
// Every state as a plate: code, name and the number of 2026 races on its
// ballot. Used by the home page and the states index.
import { getRaceIndex, getStates } from '../lib/data';
import { stateUrl } from '../lib/format';
import { t } from '../i18n';

const states = getStates();
const races = getRaceIndex();
const countFor = (po: string) => races.filter((r) => r.state_po === po).length;
const countLabel = (n: number) => (n === 1 ? t('plate.raceOne') : t('plate.races', { count: n }));
---
<ul class="tiles states">
  {states.map((s) => (
    <li>
      <a href={stateUrl(s.state_po)} aria-label={s.state_name}><b class="tile-mark">{s.state_po}</b><span class="tile-name">{s.state_name}</span></a>
      <span class="note">{countLabel(countFor(s.state_po))}</span>
    </li>
  ))}
</ul>
