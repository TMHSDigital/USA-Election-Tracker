---
// Title block shared by every page: optional breadcrumb, optional kicker line
// (for example the office above a race title), the title, and a lede.
interface Props {
  title: string;
  kicker?: string;
  lede?: string;
}
const { title, kicker, lede } = Astro.props;
---
<div class="page-header">
  {Astro.slots.has('crumbs') && <p class="crumbs"><slot name="crumbs" /></p>}
  {kicker && <p class="kicker">{kicker}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>
