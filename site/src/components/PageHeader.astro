---
// Title block shared by every page: optional breadcrumb, optional kicker line
// (for example the office above a race title), the title with an optional
// status label beside it, and a lede.
interface Props {
  title: string;
  kicker?: string;
  lede?: string;
  status?: string;
  provisional?: boolean;
  /** Sheet number shown as a plate: a short mark (state code) and a line beneath it. */
  plate?: { mark: string; label: string };
}
const { title, kicker, lede, status, provisional = false, plate } = Astro.props;
---
<div class={`page-header${plate ? ' has-plate' : ''}`}>
  {plate && <p class="plate" aria-hidden="true" data-pagefind-ignore><b>{plate.mark}</b><span>{plate.label}</span></p>}
  {Astro.slots.has('crumbs') && <p class="crumbs" data-pagefind-ignore><slot name="crumbs" /></p>}
  {kicker && <p class="kicker">{kicker}</p>}
  {status ? (
    <div class="title-row">
      <h1>{title}</h1>
      <span class={`status${provisional ? ' provisional' : ''}`}>{status}</span>
    </div>
  ) : <h1>{title}</h1>}
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>
