---
// National map rendered to static SVG at build time. Every state is a link to
// its page. One fill for all states: nothing here encodes parties or outcomes.
// Small northeastern states and DC are listed down the right edge with leader
// lines, so each of the 51 jurisdictions has a readable text link in the map.
//
// Hover or keyboard focus on a state reveals a small tip with its name and the
// offices on its 2026 ballot. The tips live in a group drawn after every state
// so they are never covered, and CSS sibling selectors show the right one.
// No JavaScript: browsers that miss the selector still get the <title>.
import { getRaceIndex, getStates, readGeo } from '../lib/data';
import { bboxOf, labelPoint, projectUsStates } from '../lib/geo';
import { stateUrl } from '../lib/format';
import { t } from '../i18n';
import MapDefs from './MapDefs.astro';

interface Props {
  caption?: string;
}
const { caption = t('map.us.caption') } = Astro.props;

const geo = readGeo('states.geojson');
const names = new Map(getStates().map((s) => [s.state_po, s.state_name]));
const shapes = geo ? projectUsStates(geo) : [];

const races = getRaceIndex();
function seats(po: string): string {
  const mine = races.filter((r) => r.state_po === po);
  const house = mine.filter((r) => r.office === 'house').length;
  const parts = [house === 1 ? t('map.tip.houseOne') : t('map.tip.house', { count: house })];
  if (mine.some((r) => r.office === 'senate')) parts.push(t('map.tip.senate'));
  if (mine.some((r) => r.office === 'governor')) parts.push(t('map.tip.governor'));
  return parts.join(', ');
}

// States too small to label in place, in north-to-south order for the side list.
const SIDE = ['VT', 'NH', 'MA', 'RI', 'CT', 'NJ', 'DE', 'MD', 'DC'];
// Nudges for states whose bounding-box center falls on water or an odd lobe.
const NUDGE: Record<string, [number, number]> = {
  FL: [22, 10], MI: [26, 30], LA: [-12, -8], ID: [-4, 28], AK: [20, -14], HI: [34, 14],
  MN: [-6, 10], WI: [0, 10], VA: [10, 6], NY: [6, 8], CA: [-8, 0], MD: [0, 0], WV: [-4, 4],
  NC: [8, 0], KY: [8, 6], TN: [0, 0], OK: [12, 6], TX: [0, 0], WA: [0, 0], MA: [0, 0],
};
const labels = shapes.map((s) => {
  const p = labelPoint(s.d);
  const [dx, dy] = NUDGE[s.key] ?? [0, 0];
  return { po: s.key, x: (p?.x ?? 0) + dx, y: (p?.y ?? 0) + dy, side: SIDE.includes(s.key) };
});
const sideItems = labels.filter((l) => l.side).sort((a, b) => a.y - b.y);
const SIDE_X = 918, SIDE_Y0 = 118, SIDE_STEP = 24;
// Crop the canvas to the drawn shapes plus the side list.
const boxes = shapes.map((s) => bboxOf(s.d));
const minX = Math.min(...boxes.map((b) => b[0])) - 8;
const minY = Math.min(...boxes.map((b) => b[1])) - 8;
const maxX = Math.max(SIDE_X + 36, ...boxes.map((b) => b[2])) + 8;
const maxY = Math.max(...boxes.map((b) => b[3])) + 8;
const viewBox = `${minX} ${minY} ${maxX - minX} ${maxY - minY}`;

// Tip boxes: anchored to the label point, flipped to stay inside the canvas.
const TIP_W = 204, TIP_H = 46;
const tips = labels.map((l) => {
  const sideIndex = sideItems.findIndex((s) => s.po === l.po);
  let x: number, y: number;
  if (sideIndex >= 0) {
    x = SIDE_X - TIP_W - 12;
    y = SIDE_Y0 + sideIndex * SIDE_STEP - TIP_H / 2;
  } else {
    x = l.x + 16;
    y = l.y - TIP_H - 10;
    if (x + TIP_W > maxX - 4) x = l.x - TIP_W - 16;
    if (y < minY + 4) y = l.y + 14;
  }
  return { po: l.po, x: Math.round(x), y: Math.round(y) };
});
const tipCss = labels
  .map((l) => `.us-map a[data-po="${l.po}"]:hover ~ .tips .tip[data-po="${l.po}"],.us-map a[data-po="${l.po}"]:focus-visible ~ .tips .tip[data-po="${l.po}"]{display:block}`)
  .join('');
---
{shapes.length > 0 && (
  <figure class="map-nav us-map">
    <svg viewBox={viewBox} role="group" aria-label={t('map.us.label')}>
      <MapDefs />
      {shapes.map((s) => (
        <a href={stateUrl(s.key)} aria-label={names.get(s.key) ?? s.key} data-po={s.key}>
          <title>{names.get(s.key) ?? s.key}</title>
          <path d={s.d} />
        </a>
      ))}
      <g class="labels" aria-hidden="true">
        {labels.filter((l) => !l.side).map((l) => <text x={l.x} y={l.y} font-size="13">{l.po}</text>)}
      </g>
      <g class="leaders" aria-hidden="true">
        {sideItems.map((l, i) => <line x1={SIDE_X - 6} y1={SIDE_Y0 + i * SIDE_STEP} x2={l.x} y2={l.y} />)}
      </g>
      {sideItems.map((l, i) => (
        <a class="side" href={stateUrl(l.po)} aria-label={names.get(l.po) ?? l.po} data-po={l.po}>
          <title>{names.get(l.po) ?? l.po}</title>
          <text x={SIDE_X} y={SIDE_Y0 + i * SIDE_STEP} font-size="13">{l.po}</text>
        </a>
      ))}
      <g class="tips" aria-hidden="true">
        {tips.map((tip) => (
          <g class="tip" data-po={tip.po}>
            <rect x={tip.x} y={tip.y} width={TIP_W} height={TIP_H} />
            <text class="tip-name" x={tip.x + 10} y={tip.y + 19}>{names.get(tip.po) ?? tip.po}</text>
            <text class="tip-seats" x={tip.x + 10} y={tip.y + 36}>{seats(tip.po)}</text>
          </g>
        ))}
      </g>
    </svg>
    <figcaption class="map-caption">{caption}</figcaption>
    <Fragment set:html={`<style>${tipCss}</style>`} />
  </figure>
)}

<style is:global>
  /* Labels are unreadable on narrow screens; the full state list follows the map. */
  @media (max-width: 40rem) { .us-map .labels, .us-map .leaders, .us-map .side, .us-map .tips { display: none; } }
  .us-map .side text { text-anchor: start; pointer-events: auto; }
  .us-map .side:hover text, .us-map .side:focus-visible text { text-decoration: underline; fill: var(--accent); }
  .us-map .leaders line { stroke: var(--graphite); stroke-width: 1; }
</style>
