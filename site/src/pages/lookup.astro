---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getStates } from '../lib/data';
import MapDefs from '../components/MapDefs.astro';
import UsMap from '../components/UsMap.astro';
import { dataUrl, url } from '../lib/format';
import { t } from '../i18n';

const states = getStates();
// Strings the island needs, taken from the locale file at build time.
const strings = {
  locating: t('lookup.locating'),
  denied: t('lookup.locationDenied'),
  noGeo: t('lookup.noGeolocation'),
  outside: t('lookup.outside'),
  result: t('lookup.result', { district: '{district}' }),
  selected: t('lookup.selected', { district: '{district}' }),
  near: t('lookup.nearBoundary'),
  official: t('lookup.officialLookup', { state: '{state}' }),
  races: t('lookup.races'),
  loading: t('lookup.loading'),
  loadError: t('lookup.loadError'),
  atLarge: t('race.title.houseAtLarge', { state: '{state}' }),
  district: t('race.title.house', { state: '{state}', district: '{district}' }),
  delegate: t('race.title.houseDelegate'),
  shortAtLarge: t('race.short.houseAtLarge'),
  shortDistrict: t('race.short.house', { district: '{district}' }),
  shortDelegate: t('race.short.houseDelegate'),
  mapHeading: t('lookup.mapHeading'),
  districtList: t('lookup.districtList'),
};
---
<Base title={t('lookup.title')} description={t('lookup.intro')}>
  <PageHeader slot="hero" title={t('lookup.title')} lede={t('lookup.intro')}>
    <p class="note" style="margin-top:0.75rem">{t('lookup.privacy')}</p>
  </PageHeader>
  <noscript><p class="notice">{t('lookup.noJs')} <a href={url('/states/')}>{t('nav.states')}</a></p></noscript>

  <svg width="0" height="0" aria-hidden="true" focusable="false" class="defs-only"><MapDefs /></svg>
  <div id="lookup" data-base={dataUrl('')} data-strings={JSON.stringify(strings)} hidden>
    <div class="panel lookup-controls">
      <div>
        <button type="button" class="button" id="locate">{t('lookup.useLocation')}</button>
      </div>
      <p class="or">{t('lookup.or')}</p>
      <p>
        <label for="state">{t('lookup.chooseState')}</label><br />
        <select id="state">
          <option value="">{t('lookup.selectState')}</option>
          {states.map((s) => <option value={s.state_po}>{s.state_name}</option>)}
        </select>
      </p>
    </div>
    <div id="status" role="status" aria-live="polite" class="note"></div>
    <div id="result" tabindex="-1"></div>
    <section id="picker" hidden aria-labelledby="h-picker">
      <h2 id="h-picker">{t('lookup.mapHeading')}</h2>
      <p class="note">{t('lookup.mapHelp')}</p>
      <div id="map" class="map-nav"></div>
      <h3>{t('lookup.districtList')}</h3>
      <ul id="district-list" class="chips"></ul>
    </section>
  </div>
  <div class="hero-map lookup-map" id="state-pick">
    <UsMap caption={t('lookup.mapStates')} />
  </div>
  <p class="note">{t('lookup.accuracy')}</p>
</Base>

<style is:global>
  .defs-only { position: absolute; }
  .lookup-map { margin-top: var(--s4); }
  .lookup-map .us-map { max-width: 56rem; }
  .lookup-map a[data-picked="true"] path { fill: var(--accent-tint); stroke: var(--ink); stroke-width: 2; }
  .lookup-controls { max-width: 40rem; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s3); }
  .lookup-controls p { margin: 0; }
  .lookup-controls .or { color: var(--graphite); font-size: var(--step--1); }
  .lookup-controls select { min-width: 16rem; margin-top: 0.3rem; }
  #status:not(:empty) { margin-top: var(--s2); }
  #result:not(:empty) { max-width: var(--measure); margin-top: var(--s3); padding: var(--s3); background: var(--paper-2); border-left: 4px solid var(--accent); }
  #result > p:first-child { font-family: var(--display); font-stretch: var(--condensed); font-weight: 700; font-size: var(--step-2); line-height: 1.1; }
  #result h2 { margin-top: var(--s3); font-size: var(--step-1); }
  #result ul { padding-left: 1.1rem; }
  #map svg { width: 100%; max-width: 44rem; max-height: 60vh; height: auto; display: block; }
  #map path { cursor: pointer; outline: none; }
  #map text { font-family: var(--display); font-stretch: var(--condensed); font-weight: 700; fill: var(--ink); text-anchor: middle; dominant-baseline: central; pointer-events: none; }
  #map path:hover, #map path:focus-visible { fill: url(#hatch); stroke: var(--ink); stroke-width: 1.5; }
  #map path:focus-visible { stroke: var(--focus); stroke-width: 3; }
  #map path[aria-pressed="true"] { fill: var(--accent-tint); stroke: var(--ink); stroke-width: 2.5; }
  .chips { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr)); gap: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); max-width: 44rem; }
  .chips li { max-width: none; display: flex; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .chips button { flex: 1; background: var(--paper); border: 0; padding: 0.7rem 0.75rem; font: inherit; font-family: var(--display); font-stretch: 85%; font-weight: 700; font-size: 1rem; color: var(--ink); cursor: pointer; text-align: left; }
  .chips button:hover { background: var(--hatch); }
</style>

<script>
  import { contains, edgeDistanceMeters, type Feature } from '../scripts/pip';

  type FC = { features: Feature[] };
  type Link = { office: string; title: string; url: string };
  type Index = Record<string, { name: string; voter_info_url: string | null; house: Record<string, Link>; statewide: Link[] }>;

  const root = document.getElementById('lookup')!;
  root.hidden = false;
  const base = root.dataset.base!;
  const S = JSON.parse(root.dataset.strings!) as Record<string, string>;
  const status = document.getElementById('status')!;
  const result = document.getElementById('result')!;
  const picker = document.getElementById('picker')!;
  const mapEl = document.getElementById('map')!;
  const list = document.getElementById('district-list')!;
  const select = document.getElementById('state') as HTMLSelectElement;
  const statePick = document.getElementById('state-pick')!;
  const stateLinks = [...statePick.querySelectorAll<HTMLAnchorElement>('a[data-po]')];
  const NEAR_METERS = 150;

  const cache = new Map<string, Promise<unknown>>();
  function load<T>(path: string): Promise<T> {
    if (!cache.has(path)) {
      cache.set(path, fetch(base + path).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      }));
    }
    return cache.get(path) as Promise<T>;
  }
  const fill = (tpl: string, v: Record<string, string>) => tpl.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');
  const el = (tag: string, text?: string) => { const e = document.createElement(tag); if (text) e.textContent = text; return e; };

  function districtLabel(po: string, name: string, d: number): string {
    if (po === 'DC') return S.delegate;
    return d === 0 ? fill(S.atLarge, { state: name }) : fill(S.district, { state: name, district: String(d) });
  }
  // Chip text under a heading that already names the state.
  function shortLabel(po: string, d: number): string {
    if (po === 'DC') return S.shortDelegate;
    return d === 0 ? S.shortAtLarge : fill(S.shortDistrict, { district: String(d) });
  }

  async function show(po: string, district: number, near: boolean, picked = false) {
    const idx = await load<Index>('lookup-index.json');
    const st = idx[po];
    result.replaceChildren();
    result.append(el('p', fill(picked ? S.selected : S.result, { district: districtLabel(po, st.name, district) })));
    mapEl.querySelectorAll('path').forEach((p) => p.setAttribute('aria-pressed', String(p.dataset.district === String(district))));
    if (near) { const n = el('p', S.near); n.className = 'notice'; result.append(n); }
    result.append(el('h2', S.races));
    const ul = el('ul');
    const links = [...st.statewide, st.house[String(district)]].filter(Boolean);
    for (const l of links) {
      const li = el('li');
      const a = el('a', `${l.office}: ${l.title}`) as HTMLAnchorElement;
      a.href = l.url;
      li.append(a);
      ul.append(li);
    }
    result.append(ul);
    if (st.voter_info_url) {
      const a = el('a', fill(S.official, { state: st.name })) as HTMLAnchorElement;
      a.href = st.voter_info_url;
      const p = el('p'); p.append(a); result.append(p);
    }
    result.focus();
  }

  async function locate() {
    if (!('geolocation' in navigator)) { status.textContent = S.noGeo; return; }
    status.textContent = S.locating;
    navigator.geolocation.getCurrentPosition(async (pos) => {
      const x = pos.coords.longitude, y = pos.coords.latitude;
      try {
        status.textContent = S.loading;
        const states = await load<FC>('boundaries/states.geojson');
        const sf = states.features.find((f) => contains(f, x, y));
        if (!sf) { status.textContent = S.outside; return; }
        const po = String(sf.properties.state_po);
        const cds = await load<FC>(`boundaries/lookup/${po.toLowerCase()}.geojson`);
        const hit = cds.features.find((f) => contains(f, x, y));
        status.textContent = '';
        if (!hit) { select.value = po; await showPicker(po); status.textContent = S.near; return; }
        const near = edgeDistanceMeters(hit, x, y) < NEAR_METERS;
        select.value = po;
        markState(po);
        await show(po, Number(hit.properties.district), near);
      } catch { status.textContent = S.loadError; }
    }, () => { status.textContent = S.denied; }, { enableHighAccuracy: true, timeout: 15000, maximumAge: 300000 });
  }

  function markState(po: string) {
    for (const a of stateLinks) a.setAttribute('data-picked', String(a.dataset.po === po));
    statePick.hidden = po !== '';
  }

  async function showPicker(po: string) {
    markState(po);
    picker.hidden = false;
    mapEl.replaceChildren();
    list.replaceChildren();
    status.textContent = S.loading;
    let fc: FC;
    try { fc = await load<FC>(`boundaries/display/${po.toLowerCase()}.geojson`); }
    catch { status.textContent = S.loadError; return; }
    status.textContent = '';
    const idx = await load<Index>('lookup-index.json');
    const name = idx[po].name;
    // Project with cos(lat) scaling, as the static maps do.
    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    const lon = (v: number) => (v > 0 ? v - 360 : v);
    const rings = (f: Feature) => (f.geometry.type === 'Polygon' ? [f.geometry.coordinates as number[][][]] : (f.geometry.coordinates as number[][][][]));
    for (const f of fc.features) for (const p of rings(f)) for (const r of p) for (const [a, b] of r) {
      minX = Math.min(minX, lon(a)); maxX = Math.max(maxX, lon(a)); minY = Math.min(minY, b); maxY = Math.max(maxY, b);
    }
    const k = Math.cos(((minY + maxY) / 2) * Math.PI / 180), W = 600, sc = W / ((maxX - minX) * k || 1);
    const svgNS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(svgNS, 'svg');
    svg.setAttribute('viewBox', `0 0 ${W} ${Math.round((maxY - minY) * sc)}`);
    svg.setAttribute('role', 'group');
    svg.setAttribute('aria-label', S.mapHeading);
    const px = (a: number) => (lon(a) - minX) * k * sc;
    const py = (b: number) => (maxY - b) * sc;
    const labels = document.createElementNS(svgNS, 'g');
    labels.setAttribute('aria-hidden', 'true');
    for (const f of fc.features) {
      const d = Number(f.properties.district);
      const path = document.createElementNS(svgNS, 'path');
      path.setAttribute('d', rings(f).flat().map((r) => 'M' + r.map(([a, b]) => `${px(a).toFixed(1)} ${py(b).toFixed(1)}`).join('L') + 'Z').join(''));
      // Number the district at the center of its largest outer ring when there is room.
      let best: { x: number; y: number; size: number; area: number } | null = null;
      for (const poly of rings(f)) {
        let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
        for (const [a, b] of poly[0]) { const X = px(a), Y = py(b); x0 = Math.min(x0, X); y0 = Math.min(y0, Y); x1 = Math.max(x1, X); y1 = Math.max(y1, Y); }
        const w = x1 - x0, h = y1 - y0;
        if (!best || w * h > best.area) best = { x: (x0 + x1) / 2, y: (y0 + y1) / 2, size: Math.min(w, h), area: w * h };
      }
      if (d > 0 && best && best.size >= 26) {
        const text = document.createElementNS(svgNS, 'text');
        text.setAttribute('x', best.x.toFixed(1));
        text.setAttribute('y', best.y.toFixed(1));
        text.setAttribute('font-size', '14');
        text.textContent = String(d);
        labels.append(text);
      }
      const label = districtLabel(po, name, d);
      path.setAttribute('tabindex', '0');
      path.setAttribute('role', 'button');
      path.setAttribute('aria-label', label);
      const t = document.createElementNS(svgNS, 'title'); t.textContent = label; path.append(t);
      path.dataset.district = String(d);
      const choose = () => void show(po, d, false, true);
      path.addEventListener('click', choose);
      path.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(); } });
      svg.append(path);
      const li = el('li');
      const b = el('button', shortLabel(po, d)) as HTMLButtonElement;
      b.type = 'button';
      b.setAttribute('aria-label', label);
      b.addEventListener('click', () => void show(po, d, false, true));
      li.append(b);
      list.append(li);
    }
    svg.append(labels);
    mapEl.append(svg);
  }

  document.getElementById('locate')!.addEventListener('click', () => void locate());
  select.addEventListener('change', () => { if (select.value) void showPicker(select.value); else { picker.hidden = true; markState(''); } });
  // With script, the national map picks a state in place instead of leaving the page.
  for (const a of stateLinks) {
    a.addEventListener('click', (e) => {
      e.preventDefault();
      select.value = a.dataset.po!;
      void showPicker(select.value).then(() => picker.scrollIntoView({ block: 'start' }));
    });
  }
</script>
