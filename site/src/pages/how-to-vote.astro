---
import Base from '../layouts/Base.astro';
import Cite from '../components/Cite.astro';
import PageHeader from '../components/PageHeader.astro';
import { ADAPTERS_FOR, getStates } from '../lib/data';
import { voteGovUrl } from '../lib/format';
import { t } from '../i18n';

const states = getStates();
---
<Base title={t('howToVote.title')} description={t('howToVote.intro')} adapters={ADAPTERS_FOR.state}>
  <PageHeader slot="hero" title={t('howToVote.title')} lede={t('howToVote.intro')}>
    <p style="margin-top:1rem"><a href="https://vote.gov/">{t('howToVote.voteGov')}</a><Cite ids={['vote_gov']} /></p>
  </PageHeader>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">{t('howToVote.col.state')}</th>
          <th scope="col">{t('howToVote.col.official')}</th>
          <th scope="col">{t('howToVote.col.voteGov')}</th>
          <th scope="col" class="src">{t('race.col.source')}</th>
        </tr>
      </thead>
      <tbody>
        {states.map((s) => (
          <tr data-figure>
            <th scope="row">{s.state_name}</th>
            <td>{s.office?.voter_info_url ? <a href={s.office.voter_info_url}>{s.office.office_name}</a> : s.office?.homepage_url ? <a href={s.office.homepage_url}>{s.office.office_name}</a> : ''}</td>
            <td><a href={voteGovUrl(s.state_name)}>{`Vote.gov: ${s.state_name}`}</a></td>
            <td class="src"><Cite ids={[...(s.office?.source_ids ?? []), 'vote_gov']} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
