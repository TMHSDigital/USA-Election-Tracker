---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import UsMap from '../components/UsMap.astro';
import { ADAPTERS_FOR, getRaceIndex, getStates } from '../lib/data';
import { stateUrl, url } from '../lib/format';
import { t } from '../i18n';

const races = getRaceIndex();
const count = (o: string) => races.filter((r) => r.office === o).length;
const states = getStates();
const offices = [
  ['/house/', 'office.house', 'home.houseSeats', count('house')],
  ['/senate/', 'office.senate', 'home.senateSeats', count('senate')],
  ['/governors/', 'office.governor', 'home.governorSeats', count('governor')],
] as const;
---
<Base title={t('site.name')} adapters={ADAPTERS_FOR.home}>
  <div class="hero">
    <PageHeader title={t('home.title')} lede={t('site.tagline')} />
    <UsMap />
  </div>

  <section aria-labelledby="h-offices">
    <h2 id="h-offices">{t('home.officesHeading')}</h2>
    <p class="note">{t('home.officesLede')}</p>
    <ul class="offices">
      {offices.map(([href, name, seats, n]) => (
        <li><a href={url(href)}>{t(name)}</a><p>{t(seats, { count: n })}</p></li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-states">
    <h2 id="h-states">{t('home.statesHeading')}</h2>
    <ul class="grid">
      {states.map((s) => <li><a href={stateUrl(s.state_po)}>{s.state_name}</a></li>)}
    </ul>
  </section>

  <section aria-labelledby="h-principles">
    <h2 id="h-principles">{t('home.principles')}</h2>
    <ul>
      <li>{t('home.p1')}</li>
      <li>{t('home.p2')}</li>
      <li>{t('home.p3')}</li>
      <li>{t('home.p4')}</li>
    </ul>
    <p><a href={url('/methodology/')}>{t('footer.methodology')}</a></p>
  </section>
</Base>
