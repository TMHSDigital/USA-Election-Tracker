---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import StatePlates from '../components/StatePlates.astro';
import UsMap from '../components/UsMap.astro';
import { ADAPTERS_FOR, getRaceIndex } from '../lib/data';
import { url } from '../lib/format';
import { t } from '../i18n';

const races = getRaceIndex();
const count = (o: string) => races.filter((r) => r.office === o).length;
const offices = [
  ['/house/', 'office.house', 'home.office.houseNote', count('house')],
  ['/senate/', 'office.senate', 'home.office.senateNote', count('senate')],
  ['/governors/', 'office.governor', null, count('governor')],
] as const;
---
<Base title={t('site.name')} adapters={ADAPTERS_FOR.home}>
  <Fragment slot="hero">
    <PageHeader title={t('home.title')} lede={t('site.tagline')} />
    <div class="hero-map">
      <UsMap />
    </div>
  </Fragment>

  <section aria-labelledby="h-offices">
    <h2 id="h-offices">{t('home.officesHeading')}</h2>
    <p class="note">{t('home.officesLede')}</p>
    <ul class="tiles offices">
      {offices.map(([href, name, note, n]) => (
        <li>
          <a href={url(href)}><span class="tile-kicker">{t('home.office.kicker')}</span><b class="tile-mark">{n}</b><span class="tile-name">{t(name)}</span></a>
          {note && <span class="note">{t(note)}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="lookup-call" aria-labelledby="h-lookup">
    <div>
      <h2 id="h-lookup">{t('home.entry.lookup')}</h2>
      <p>{t('home.entry.lookupBody')}</p>
    </div>
    <a class="button" href={url('/lookup/')}>{t('home.entry.lookup')}</a>
  </section>

  <section aria-labelledby="h-states">
    <h2 id="h-states">{t('home.statesHeading')}</h2>
    <StatePlates />
  </section>

  <section aria-labelledby="h-principles">
    <h2 id="h-principles">{t('home.about')}</h2>
    <ul class="principles">
      <li>{t('home.p1')}</li>
      <li>{t('home.p2')}</li>
      <li>{t('home.p3')}</li>
      <li>{t('home.p4')}</li>
    </ul>
    <p><a href={url('/methodology/')}>{t('footer.methodology')}</a></p>
  </section>
</Base>
