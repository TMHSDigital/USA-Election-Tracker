---
import Base from '../layouts/Base.astro';
import Cite from '../components/Cite.astro';
import LiveResults from '../components/LiveResults.astro';
import PageHeader from '../components/PageHeader.astro';
import { ADAPTERS_FOR, getMeta, getStates } from '../lib/data';
import { t } from '../i18n';

const states = getStates();
const live = getMeta().live_enabled;
---
<Base title={t('night.title')} description={t('night.intro')} adapters={live ? [...ADAPTERS_FOR.state, 'live_clarity'] : ADAPTERS_FOR.state}>
  <PageHeader slot="hero" title={t('night.title')} lede={t('night.intro')}>
    <p class="statement">{t('night.noCalls')}</p>
  </PageHeader>

  <section aria-labelledby="h-official">
    <h2 id="h-official">{t('night.officialHeading')}</h2>
    <div class="table-scroll">
      <table class="register">
        <thead><tr><th scope="col">{t('night.col.state')}</th><th scope="col">{t('night.col.results')}</th><th scope="col" class="src">{t('race.col.source')}</th></tr></thead>
        <tbody>
          {states.map((s) => (
            <tr data-figure>
              <th scope="row">{s.state_name}</th>
              <td>{s.office?.results_url ? <a href={s.office.results_url}>{s.office.office_name}</a> : t('night.noLink')}</td>
              <td class="src">{s.office ? <Cite ids={s.office.source_ids} /> : <Cite ids={['project_seeds']} />}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-live">
    <h2 id="h-live">{t('night.liveHeading')}</h2>
    {live ? <LiveResults /> : <p>{t('night.liveDisabled')}</p>}
  </section>
</Base>
