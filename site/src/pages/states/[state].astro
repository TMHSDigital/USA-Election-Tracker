---
import Base from '../../layouts/Base.astro';
import Cite from '../../components/Cite.astro';
import PageHeader from '../../components/PageHeader.astro';
import StateMap from '../../components/StateMap.astro';
import { ADAPTERS_FOR, getRaceIndex, getStates } from '../../lib/data';
import { raceTitle, raceUrl, url, voteGovUrl } from '../../lib/format';
import { fmtDate, t } from '../../i18n';

export function getStaticPaths() {
  return getStates().map((s) => ({ params: { state: s.state_po.toLowerCase() } }));
}

const state = getStates().find((s) => s.state_po.toLowerCase() === Astro.params.state)!;
const races = getRaceIndex().filter((r) => r.state_po === state.state_po);
const byOffice = (o: string) => races.filter((r) => r.office === o);
const o = state.office;
const groups = [
  ['governor', 'state.governor', 'state.noGovernor'],
  ['senate', 'state.senate', 'state.noSenate'],
  ['house', 'state.house', null],
] as const;
const countLabel = (n: number) => (n === 1 ? t('state.candidateCountOne') : t('state.candidateCount', { count: n }));
const statusText = (r: (typeof races)[number]) =>
  r.list_status === 'official' ? countLabel(r.candidate_count) : t(`state.listStatus.${r.list_status}` as 'state.listStatus.unavailable');
const description = t('state.description', { state: state.state_name, count: races.length });
---
<Base title={state.state_name} description={description} adapters={ADAPTERS_FOR.state}>
  <PageHeader title={state.state_name} lede={description}>
    <a slot="crumbs" href={url('/states/')}>{t('nav.states')}</a>
  </PageHeader>

  <div class="layout">
    <aside class="aside" aria-label={t('state.office')}>
      <dl>
        <dt>{t('state.generalElection')}</dt>
        <dd data-figure>{fmtDate(o?.general_election_date ?? '2026-11-03')}{o && <Cite ids={o.source_ids} />}</dd>
        <dt>{t('state.office')}</dt>
        {o ? (
          <dd data-figure>{o.homepage_url ? <a href={o.homepage_url}>{o.office_name}</a> : o.office_name}<Cite ids={o.source_ids} /></dd>
        ) : <dd>{t('state.noOffice')}</dd>}
        {o?.voter_info_url && <><dt>{t('state.voterInfo')}</dt><dd><a href={o.voter_info_url}>{o.office_name}</a></dd></>}
        {o?.results_url && <><dt>{t('state.results')}</dt><dd><a href={o.results_url}>{o.office_name}</a></dd></>}
        <dt>{t('state.register')}</dt>
        <dd><a href={voteGovUrl(state.state_name)}>Vote.gov</a><Cite ids={['vote_gov']} /></dd>
        {state.boundary_set && (
          <>
            <dt>{t('state.boundaries')}</dt>
            <dd data-figure>{state.boundary_set.enacting_instrument_url ? <a href={state.boundary_set.enacting_instrument_url}>{state.boundary_set.enacting_instrument}</a> : state.boundary_set.enacting_instrument}<Cite ids={state.boundary_set.source_ids} /></dd>
          </>
        )}
      </dl>
    </aside>

    <div class="content">
      {byOffice('house').length > 1 && (
        <section aria-labelledby="h-map">
          <h2 id="h-map">{t('state.map')}</h2>
          <StateMap statePo={state.state_po} stateName={state.state_name}>
            {t('map.state.caption', { state: state.state_name })}
          </StateMap>
        </section>
      )}

      <section aria-labelledby="h-races">
        <h2 id="h-races">{t('state.races')}</h2>
        {groups.map(([office, label, none]) => {
          const list = byOffice(office);
          return (
            <>
              <h3>{t(label)}</h3>
              {list.length === 0 && none ? <p>{t(none, { state: state.state_name })}</p> : (
                <ul class="tiles">
                  {list.map((r) => (
                    <li>
                      <a href={raceUrl(r.race_id)}>{raceTitle(r)}</a>
                      <span class="note">{statusText(r)}</span>
                    </li>
                  ))}
                </ul>
              )}
            </>
          );
        })}
      </section>
    </div>
  </div>
</Base>
