---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import UsMap from '../../components/UsMap.astro';
import { getStates } from '../../lib/data';
import { stateUrl } from '../../lib/format';
import { t } from '../../i18n';

const states = getStates();
---
<Base title={t('states.title')} description={t('states.intro')}>
  <div class="hero">
    <PageHeader title={t('states.title')} lede={t('states.intro')} />
    <UsMap />
  </div>
  <ul class="grid">
    {states.map((s) => <li><a href={stateUrl(s.state_po)}>{s.state_name}</a></li>)}
  </ul>
</Base>
