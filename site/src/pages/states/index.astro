---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import StatePlates from '../../components/StatePlates.astro';
import UsMap from '../../components/UsMap.astro';
import { t } from '../../i18n';
---
<Base title={t('states.title')} description={t('states.intro')}>
  <Fragment slot="hero">
    <PageHeader title={t('states.title')} lede={t('states.intro')} />
    <div class="hero-map">
      <UsMap />
    </div>
  </Fragment>
  <StatePlates />
</Base>
