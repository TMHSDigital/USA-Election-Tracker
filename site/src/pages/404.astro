---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/format';
import { t } from '../i18n';
---
<Base title={t('notFound.title')} noindex>
  <PageHeader slot="hero" title={t('notFound.title')} lede={t('notFound.body')} />
  <ul>
    <li><a href={url('/')}>{t('nav.home')}</a></li>
    <li><a href={url('/states/')}>{t('nav.states')}</a></li>
    <li><a href={url('/search/')}>{t('nav.search')}</a></li>
  </ul>
</Base>
